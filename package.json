{
  "name": "bas-hiring",
  "version": "1.0.0",
  "description": "BAS Hiring Platform - Monolithic Deployment",
  "main": "monolithic.js",
  "type": "module",
  "scripts": {
    "start": "node monolithic.js",
    "build": "npx prisma generate && echo 'Installing client dependencies' && cd client && npm install --legacy-peer-deps && echo 'Building client' && CI=false npm run build && cd .. && echo 'Build completed'",
    "dev": "nodemon monolithic.js",
    "postinstall": "prisma generate",
    "check": "node server/db/prisma.check.js",
    "check:security": "node server/db/security.check.js",
    "check:all": "npm run check && npm run check:security"
  },
  "engines": {
    "node": ">=18.x"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "uuid": "^11.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.19.3"
  }
}
